# Напиши функцию get_words_longer_than(words, n), которая:
# 1. Принимает список слов и число n
# 2. Возвращает новый список, содержащий только слова длиннее n
# 3. Используй цикл for и len()

def get_words_longer_than(words, n):
    result = []
    for word in words:
        if len(word) > n:
            result.append(word)
    return result

print(get_words_longer_than(["кот", "собака", "слон", "бегемот"], 4))
print(get_words_longer_than(["дом", "машина", "стол"], 3))

# Напиши функцию get_average_grade(grades), которая:
# 1. Принимает список оценок (числа)
# 2. Возвращает средний балл (сумма всех оценок / их количество)
# 3. Если список пустой — возвращает 0
# 4. Используй sum() и len()

def get_average_grade(grades):
    result = []
    if len(grades) == 0:
        return 0
    return sum(grades) / len(grades) # sum(grades) — встроенная функция, которая считает сумму всех чисел в списке.
print(get_average_grade([1, 3, 7, 8, 9]))
print(get_average_grade([4, 6, 7, 99]))
print(get_average_grade([]))

# Напиши функцию get_max(numbers), которая:
# 1. Принимает список чисел
# 2. Возвращает самое большое число в списке
# 3. Используй цикл for и переменную max_num

def get_max(numbers):
    max_num = numbers[0]
    for num in numbers:
        if num > max_num:
            max_num = num
    return max_num
print(get_max([1, 4, 7, 4, 88, 55]))
print(get_max([1, 4, 7, 4, 65, 55]))


# Напиши функцию get_min(numbers), которая:
# 1. Принимает список чисел
# 2. Возвращает самое маленькое число в списке
# 3. Используй цикл for и переменную min_num

# 1. Берём ПЕРВОЕ число как "временно самое большое"
 # 2. Проходим по КАЖДОМУ числу в списке
# 3. Если текущее число БОЛЬШЕ, чем "временно самое большое"
# 4. То обновляем "временно самое большое"
# 5. Возвращаем то, что осталось
def get_min(numbers):
    min_num = numbers[0]
    for num in numbers:
        if num < min_num:
            min_num = num
    return min_num
print(get_min([44, 55, 66, 55, 34, 21]))
print(get_min([99, 55, 43, 22]))


# Напиши функцию count_letters(word), которая:
# 1. Принимает строку (слово)
# 2. Возвращает словарь, где ключи — буквы, а значения — количество раз, сколько буква встречается
# 3. Используй цикл for и словарь

def count_letters(word):
    result = {}
    for w in word:
        if w in result:
            result[w] = result[w] + 1
        else:                         
            result[w] = 1
print(count_letters(["polokiu"]))
print(count_letters(["wrottenogi"]))

# Напиши функцию get_words_starting_with(words, letter), которая:
# 1. Принимает список слов и букву
# 2. Возвращает список слов, которые начинаются с этой буквы
# 3. Используй цикл for и проверку word[0] == letter

def get_words_starting_with(words, letter):
    result = []
    for word in words:
        if word[0] == letter:
            result.append(word) # добавляем слово
    return result               # возвращаем после цикла
print(get_words_starting_with(["truiophd", "fdgdfj", "acaf"], "t"))
print(get_words_starting_with(["dfhytuyi", "arwet", "drtgdfg"], "d"))
