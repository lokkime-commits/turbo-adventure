# Напиши функцию get_longest_word(words), которая:
# 1. Принимает список слов
# 2. Возвращает самое длинное слово в списке
# 3. Используй цикл for и переменную longest
# 4. Если список пустой — возвращает None

def get_longest_word(words):
    if len(words) == 0:
        return None
    longest = words[0]
    for word in words:
        if len(word) > len(longest):
            longest = word
    return longest
print(get_longest_word(["fghh", "fdteryh", "sgridfghdgkj"]))
print(get_longest_word(["fghdyh", "fdtetyrtyryh", "sgrirtyrtydfghdgkj"]))
print(get_longest_word([]))


# Напиши функцию get_words_by_letter(words, letter), которая:
# 1. Принимает список слов и букву
# 2. Возвращает список слов, в которых есть эта буква
# 3. Используй цикл for и проверку letter in word

def get_words_by_letter(words, letter):
    result = []
    for word in words:
        if letter in word:
            result.append(word)
    return result
print(get_words_by_letter(["dadgrtg", "werwffhyi", "fyikhjkl"], "f"))
print(get_words_by_letter(["dadgrtg", "werwffhyi", "fyikhjkl"], "a"))

# Напиши функцию get_common_elements(list1, list2), которая:
# 1. Принимает два списка
# 2. Возвращает список элементов, которые есть в обоих списках
# 3. Используй цикл for и проверку in

def get_common_elements(list1, list2):
    result = []
    for item in list1: # Перебираем каждый элемент из первого списка
        if item in list2: # Проверяем: есть ли этот элемент во втором списке?
            result.append(item)
    return result
print(get_common_elements([2, 4, 9, 7], [1, 9, 7, 8]))
print(get_common_elements([3, 6, 7], [6, 9, 3]))

