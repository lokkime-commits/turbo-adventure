# Напиши функцию get_words_ending_with(words, letter), которая:
# 1. Принимает список слов и букву
# 2. Возвращает список слов, которые заканчиваются на эту букву
# 3. Используй цикл for и проверку word[-1] == letter
# Напоминание: word[-1] — это последний символ строки

def get_words_ending_with(words, letter):
    result = []
    for word in words:
        if word[-1] == letter:
            result.append(word)
    return result
print(get_words_ending_with(["truiophd", "fdgdfj", "acaf"], "f"))
print(get_words_ending_with(["truiophd", "fdgdfj", "acaf"], "j"))

# Напиши функцию get_words_by_length(words, length), которая:
# 1. Принимает список слов и число length
# 2. Возвращает список слов, длина которых равна length
