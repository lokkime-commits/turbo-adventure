def add_task(tasks):
    title = input("📝 Введи задачу: ")
    if not title.strip():
        print("❌ Задача не может быть пустой.")
        return
    
    deadline = input("📅 Введи дату выполнения (ГГГГ-ММ-ДД) или Enter: ")
    priority = input("🎯 Приоритет (высокий/средний/низкий): ").lower()
    if priority not in ["высокий", "средний", "низкий"]:
        priority = "средний"
    
    category = input("📂 Категория (работа/личное/учёба): ").lower()
    if category not in ["работа", "личное", "учёба"]:
        category = "другое"
    
    task = {
        "title": title,
        "deadline": deadline if deadline else "без даты",
        "priority": priority,
        "category": category
    }
    
    tasks.append(task)
    save_tasks(tasks)
    print(f"✅ Задача '{title}' добавлена!")
