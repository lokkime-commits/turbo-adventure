        real_index = self.tasks.index(task_data)
        
        dialog = tk.Toplevel(self.root)
        dialog.title("Редактировать задачу")
        dialog.geometry("400x300")
        dialog.grab_set()
        
        tk.Label(dialog, text="Название задачи:").pack(pady=5)
        title_entry = tk.Entry(dialog, width=40)
        title_entry.insert(0, task_data["title"])
        title_entry.pack(pady=5)
        
        tk.Label(dialog, text="Дедлайн (ГГГГ-ММ-ДД):").pack(pady=5)
        deadline_entry = tk.Entry(dialog, width=40)
        deadline_entry.insert(0, task_data.get("deadline", ""))
        deadline_entry.pack(pady=5)
        
        tk.Label(dialog, text="Приоритет:").pack(pady=5)
        priority_combo = ttk.Combobox(dialog, values=["высокий", "средний", "низкий"])
        priority_combo.set(task_data.get("priority", "средний"))
        priority_combo.pack(pady=5)
        
        tk.Label(dialog, text="Категория:").pack(pady=5)
        category_combo = ttk.Combobox(dialog, values=["работа", "личное", "учёба", "другое"])
        category_combo.set(task_data.get("category", "личное"))
        category_combo.pack(pady=5)
        
        def save():
            if update_task(self.tasks, real_index, title_entry.get(), 
                          deadline_entry.get(), priority_combo.get(), category_combo.get()):
                self.refresh_list()
                dialog.destroy()
        
        tk.Button(dialog, text="💾 Сохранить", command=save, bg="#FFD700").pack(pady=10)
    
    def delete_task(self):
        """Удаляет выбранную задачу"""
        selected = self.task_listbox.curselection()
        if not selected:
            messagebox.showwarning("Ошибка", "Выберите задачу для удаления!")
            return
        
        # Находим реальную задачу с учётом фильтров
        filtered = self.get_filtered_tasks()
        task_index_in_filtered = selected[0]
        if task_index_in_filtered >= len(filtered):
            return
        
        task_data = filtered[task_index_in_filtered]
        real_index = self.tasks.index(task_data)
        
        if messagebox.askyesno("Подтверждение", f"Удалить задачу '{task_data['title']}'?"):
            deleted = delete_task(self.tasks, real_index)
            if deleted:
                self.refresh_list()
                messagebox.showinfo("Успех", f"Задача '{deleted['title']}' удалена!")
    
    def get_filtered_tasks(self):
        """Возвращает отфильтрованный список задач"""
        filtered = self.tasks
        filtered = filter_by_category(filtered, self.category_filter.get())
        filtered = filter_by_priority(filtered, self.priority_filter.get())
        filtered = search_by_keyword(filtered, self.search_entry.get())
        return filtered

