# Задание 2: Напиши функцию get_number(), которая:
# - спрашивает "Введи число: "
# - возвращает введённое число как int
# (если пользователь ввёл не число — возвращает None)

def get_number():
    try:
        return int(input("Введи число: "))
    except ValueError:
        return None

# Проверка:
num = get_number()
if num is not None:
    print(f"Ты ввёл {num}")
else:
    print("Это было не число!")
