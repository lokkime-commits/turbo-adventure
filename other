#Напиши функцию max_of_two, которая принимает два числа и возвращает большее из них.
#print(max_of_two(10, 20))  # 20
#print(max_of_two(7, 3))    # 7
#print(max_of_two(5, 5))    # 5
#Подсказка: используй if и return.

def max_of_two(a, b):
    if a > b:
        return a
    else:
        return b
print(max_of_two(10, 20))
print(max_of_two(7, 3))    
print(max_of_two(5, 5))

#Напиши функцию repeat, которая принимает строку и число n, и возвращает строку, повторённую n раз.
#print(repeat("Hi", 3))   # HiHiHi
#print(repeat("!", 5))    # !!!!!
#Подсказка: в Python можно умножать строку на число: "Hi" * 3 → "HiHiHi"

def repeat(text, x):
    return text * x
print(repeat("Hi", 3))   # HiHiHi
print(repeat("!", 5))


