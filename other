# Напиши функцию is_positive, которая принимает число и возвращает:
# "Положительное", если число > 0
# "Ноль", если число == 0
# "Отрицательное", если число < 0

def is_positive(x):
    if x > 0:
        return "Положительное"
    elif x == 0:
        return "Ноль"
    elif x < 0:
        return "Отрицательное"
print(is_positive(5))
print(is_positive(0))
print(is_positive(-7))


#Напиши функцию get_average, которая принимает два числа и возвращает их среднее.
#Формула: (a + b) / 2
