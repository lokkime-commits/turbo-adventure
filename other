#Напиши функцию is_even, которая принимает число и возвращает:
#"Чётное", если число чётное
#"Нечётное", если число нечётное
#print(is_even(4))   # Чётное
#print(is_even(7))   # Нечётное
#Подсказка: оператор % возвращает остаток от деления. Если number % 2 == 0 — число чётное.

def is_even(x):
    return x % 2 == 0
