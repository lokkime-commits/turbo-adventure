# Напиши функцию fetch_post_data(post_id, results, lock), которая:
# 1. Принимает номер поста, общий список results и lock
# 2. Делает GET-запрос к https://jsonplaceholder.typicode.com/posts/{post_id}
# 3. Обрабатывает ответ через process_data()
# 4. Добавляет результат в results с защитой lock
# 5. Ловит ошибки через try-except

import requests  # 1 Импортируем библиотеку для запросов к интернету.

def fetch_post_data(post_id, results, lock):
    # 2 post_id — номер поста (1, 2, 3...),общий список, куда складываем результаты,замок для защиты списка
    url = f"https://jsonplaceholder.typicode.com/posts/{post_id}"
    # 3 f"..." — f-строка, {post_id} — подставляется номер (например, 1), Получается: "https://jsonplaceholder.typicode.com/posts/1", Это адрес, по которому мы запрашиваем данные.
    try:                                           # 4 Начинаем "опасную" часть. Всё, что внутри try, может вызвать ошибку (интернет может отвалиться, сайт может не ответить).
        response = requests.get(url)
        # 5 Отправляем GET-запрос на сайт
        # Что такое GET: это метод HTTP-запроса. Ты говоришь сайту: "дай мне данные".
        # response — это ответ от сайта. Внутри него — статус-код (200 = успех, 404 = не найдено) и данные.
        response.raise_for_status()
        # 6Проверяем статус-код.
        # Если 200 — всё хорошо, идём дальше
        #Если 404 или 500 — выбрасывает ошибку, и мы попадаем в except
        #Зачем: чтобы не обрабатывать "пустые" ответы.
        raw_data = response.json()
        # 7 Превращаем ответ в словарь Python.
        # Сайт возвращает JSON-строку. .json() превращает её в словарь:
        # {"userId": 1, "id": 1, "title": "...", "body": "..."}
        processed = process_data(raw_data)
        # 8 Вызываем функцию process_data (задание 160), которая оставляет только title и body.
        # processed = {"title": "...", "body": "..."}
        with lock:
            # 9Захватываем замок. Это защита от гонки данных.
            #Почему нужно:
            #10 потоков одновременно добавляют в results
            #Без замка они могут перезаписать друг друга
            #С замком — добавляют по очереди
            results.append(processed)              # 10 Добавляем обработанные данные в общий список.
    except requests.exceptions.RequestException as e:   # 11 Ловим ошибки. Если что-то пошло не так (нет интернета, сайт не ответил) — попадаем сюда. e — объект ошибки.
        print(f"Ошибка: {e}")                      # 12 Печатаем ошибку, чтобы знать, что случилось.
