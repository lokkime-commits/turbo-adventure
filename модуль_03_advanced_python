# 📋 Задание 154 (Queue — обмен данными)---------------------------------------------------------------------------------
# Напиши функцию run_queue(), которая:
# 1. Создаёт multiprocessing.Queue()
# 2. Создаёт процесс-производитель, который кладёт в очередь числа [1, 2, 3]
# 3. Создаёт процесс-потребитель, который забирает числа и печатает их
# 4. Ждёт завершения обоих процессов

import multiprocessing  # 1 Импортируем модуль для работы с процессами.

def producer(queue, items):
    #Производитель — функция,которая кладёт данные в очередь. queue — очередь (общая) items — список данных для отправки
    for item in items:  #3 Перебираем числа из списка [1, 2, 3].
        queue.put(item)  #4 Кладём число в очередь. Теперь потребитель может его забрать.
    queue.put(None) 
    #5 Отправляем "сигнал остановки". Когда потребитель увидит None, он поймёт: "больше данных не будет, можно заканчивать".

def consumer(queue):  #6 Потребитель — функция, которая забирает данные из очереди.
    while True:     #7 Бесконечный цикл — потребитель постоянно ждёт новых данных.
        item = queue.get()   #8 Забираем элемент из очереди. Если очередь пуста — ждём, пока что-то появится.
        if item is None:  #9-10 Проверяем сигнал остановки. Если получили None — выходим из цикла.
            break   # 10
        print(f"Получено: {item}")# Печатаем полученное число.

def run_queue(): # 12Главная функция, которая управляет процессами.
    q = multiprocessing.Queue() # 13 Создаём общую очередь. Её будут использовать оба процесса.
    p1 = multiprocessing.Process(target=producer, args=(q, [1, 2, 3]))
    # 14Создаём процесс-производитель: target=producer — функция, которая выполнится.args=(q, [1, 2, 3]) — аргументы для функции (очередь и список)
    p2 = multiprocessing.Process(target=consumer, args=(q,))
    # 15Создаём процесс-потребитель:target=consumer — функция, args=(q,) — аргумент (очередь). Запятая важна! Без неё это не кортеж.
    p1.start()  # 16 Запускаем оба процесса. Они начинают работать параллельно.
    p2.start()  # 17 Запускаем оба процесса. Они начинают работать параллельно.
    p1.join()  # 18 Ждём завершения обоих процессов.
    p2.join()  # 19 Ждём завершения обоих процессов.

if __name__ == '__main__': # 20 Защита от рекурсии (обязательно для multiprocessing на Windows).
