# 📋 Задание 147 (закрепление Lock)--------------------------------------------------------------------------
# Напиши функцию run_with_lock(), которая:
# 1. Создаёт общий счётчик counter = 0
# 2. Создаёт Lock
# 3. Запускает 3 потока, каждый увеличивает counter на 1000 раз
# 4. Использует Lock для защиты counter
# 5. Выводит итоговое значение (должно быть 3000)

import threading                       # 1. Импорт.Импортируем модуль и создаём общую переменную counter. Все потоки будут её менять.
counter = 0                            # 2. Общая переменная
lock = threading.Lock()                # 3. Создаём замок. Создаём замок. Пока он ничей.
def increment():                       # 4. Функция для потока
    global counter                     # 5. Говорим: работаем с глобальной
    for _ in range(1000):              # 6. 1000 раз
        with lock:                     # 7. Захватываем замок
            counter += 1               # 8. Увеличиваем
# global counter — говорим Python: "я работаю с глобальной переменной"
#for _ in range(1000) — 1000 раз
#with lock: — захватываем замок. Если другой поток уже держит замок — ждём
#counter += 1 — увеличиваем (теперь безопасно!)
#Почему with lock работает:
#with lock: автоматически делает lock.acquire() в начале
#И lock.release() в конце
#Даже если произойдёт ошибка — замок освободится
def run_with_lock():                   # 9. Главная функция
    threads = []                       # 10. Список потоков
    for i in range(3):                 # 11. Создаём 3 потока
        t = threading.Thread(target=increment)
        threads.append(t)
        t.start()                      # 12. Запускаем каждый
# Создаём пустой список threads
# В цикле 3 раза создаём поток с функцией increment
# Добавляем поток в список
# Запускаем через .start()
# Важно: потоки запускаются параллельно. Все три одновременно вызывают increment().
    for t in threads:                  # 13. Ждём завершения.Пока все три не закончат — программа не пойдёт дальше.
        t.join()
