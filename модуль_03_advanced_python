# Это Урок 31: Декораторы (Decorators).

# 1. Создаём декоратор
def my_decorator(func):
    def wrapper():
        print("Что-то происходит ДО вызова функции.")
        func()  # Вызываем оригинальную функцию
        print("Что-то происходит ПОСЛЕ вызова функции.")
    return wrapper
# 2. Создаём простую функцию
def say_hello():
    print("Hello!")
# 3. Вручную "оборачиваем" функцию
declared_say_hello = my_decorator(say_hello)
# 4. Вызываем обёрнутую функцию
declared_say_hello()

# Что произошло:
#Мы передали say_hello в my_decorator.
#Декоратор вернул новую функцию wrapper, которая "запоминает" исходную say_hello.
# Теперь declared_say_hello — это и есть wrapper.
# Когда мы её вызываем, она выполняет код до, вызывает say_hello, и выполняет код после.

def log_arguments(func):
    def wrapper(*args, **kwargs):
        print(f"Вызов {func.__name__} с args: {args}, kwargs: {kwargs}")
        result = func(*args, **kwargs)  # Передаём аргументы в оригинальную функцию
        print(f"{func.__name__} вернула: {result}")
        return result
    return wrapper
@log_arguments
def add(a, b):
    return a + b
add(10, 5)

# *args — собирает все позиционные аргументы в кортеж (например, (10, 5))
# **kwargs — собирает все именованные аргументы в словарь (например, {'greeting': 'Hi'}).

# 🎯 Декораторы с аргументами (для самого декоратора)
# Это самый сложный вариант.
# Если ты хочешь передать аргументы самому декоратору (например, @repeat(num_times=3)), то нужна ещё одна "обёртка".

def repeat(num_times):
    def decorator_repeat(func):
        def wrapper(*args, **kwargs):
            for _ in range(num_times):
                result = func(*args, **kwargs)
            return result
        return wrapper
    return decorator_repeat

@repeat(num_times=3)
def say_something(word):
    print(word)

say_something("Python")
