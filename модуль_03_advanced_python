# Напиши функцию apply_to_all_n(numbers, func, n), которая:
# 1. Принимает список чисел, функцию и число n
# 2. Применяет функцию к каждому числу n раз
# 3. Возвращает список результатов
# 4. Используй цикл для применения функции n раз

def apply_to_all_n(numbers, func, n): # func Функция (лямбда), которую будем применять/ n Сколько раз применить функцию
    result = [] # Создаём пустой список, в который будем собирать результаты.
    for x in numbers: # Внешний цикл — перебирает каждое число из списка numbers. x — текущее число (например, 1, потом 2, потом 3)
        for _ in range(n): # Внутренний цикл — повторяется n раз.
                           # _ — имя переменной-заглушки (значение не используется)
                           # range(n) — создаёт последовательность 0, 1, 2, ..., n-1
                           # Зачем: чтобы применить функцию func к числу x ровно n раз.
            x = func(x)    # Применяем функцию к текущему числу.
                           #   func(x) — вызываем лямбду с числом x
                           #Результат сохраняем обратно в x
                        #Пример: если x = 1, func = lambda x: x + 1, то x = 2.
        result.append(x)   # Добавляем итоговое значение x в список result.
    return result          # Возвращаем список результатов.
print(apply_to_all_n([1, 2, 3], lambda x: x + 1, 2))

# def apply_to_all_n(...)	Создаём функцию
# result = []	Создаём пустой список
# for x in numbers:	Перебираем числа
