5. Списки
python
fruits = ["яблоко", "банан"]      # создание
fruits.append("груша")             # добавить в конец
fruits.insert(1, "апельсин")       # вставить по индексу
fruits.remove("банан")             # удалить по значению
fruits.pop()                       # удалить последний
fruits.pop(1)                      # удалить по индексу
fruits[0]                          # первый элемент
fruits[-1]                         # последний элемент
fruits[1:3]                        # срез
len(fruits)                        # длина списка
6. Словари
python
person = {"name": "Илья", "age": 37}   # создание
person["city"] = "Москва"               # добавить
person["age"] = 38                      # изменить
print(person["name"])                   # получить значение
del person["city"]                      # удалить ключ

for key, value in person.items():       # перебор
    print(f"{key}: {value}")

if "name" in person:                    # проверка наличия ключа
    print("Есть!")
7. Функции
python
def add(a, b):
    return a + b

result = add(3, 5)        # result = 8
Запомни:

return — возвращает значение

print() — только выводит, ничего не возвращает

Без return функция возвращает None

8. Строки (методы)
python
word = "hello"
word[0]          # "h" — первый символ
word[-1]         # "o" — последний символ
len(word)        # 5 — длина строки
word.upper()     # "HELLO"
word.lower()     # "hello"
word.capitalize() # "Hello"
word.strip()     # убирает пробелы
9. Работа с файлами
python
# Чтение
with open("file.txt", "r", encoding="utf-8") as f:
    content = f.read()          # всё содержимое
    lines = f.readlines()       # список строк

# Запись (перезапись)
with open("file.txt", "w", encoding="utf-8") as f:
    f.write("текст\n")

# Добавление (в конец)
with open("file.txt", "a", encoding="utf-8") as f:
    f.write("новая строка\n")
