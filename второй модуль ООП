        self.title = title
        self.author = author
        self.pages = pages

    def __str__(self):
        return f"Название: {self.title}, Автор: {self.author}, Страниц: {self.pages}"

class Library:
    def __init__(self, name):
        self.name = name
        self.books = []          # Создаём пустой список для книг

