# Создай класс "Book" (Книга):
# 1. В __init__ принимает title, author и year
# 2. Сохраняет их в атрибуты
# 3. Создай метод get_info(), который возвращает строку:
#    "Название: {title}, Автор: {author}, Год: {year}"
# 4. Создай метод is_old(), который возвращает True, если книга старше 50 лет,
#    и False — если нет (используй текущий год 2025)
# Создай три объекта книги и выведи информацию о каждой из них.

class Book:
    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = year
        
    def get_info(self):
        return (f"{self.title}, Автор: {self.author}, Год: {self.year}")
    def is_old(self):
        return (2025 - self.year) > 50
    
Book1 = Book("Too", "yrty", 1467)
Book2 = Book("fuuu", "hfjyj", 1345)
Book3 = Book("viiii", "ggrgcfb", 689)

print(Book1.get_info())
print(Book1.is_old())
print(Book2.get_info())
print(Book2.is_old())
print(Book3.get_info())
print(Book3.is_old())
