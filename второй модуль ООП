# Создай класс Person (Человек), который:
# 1. В __init__ принимает name и age
# 2. Сохраняет их в атрибуты self.name и self.age
# 3. Имеет метод greet(), который выводит "Привет, меня зовут {name}!"
# 4. Имеет метод info(), который выводит "{name}, {age} лет"
# Создай два объекта и вызови у них оба метода.

class Person:
    def __init__(self, name, age):
        self.name = name
        self.age = age
    def greet(self):
            print(f"Привет, меня зовут {self.name}!")
    def info(self):
            print(f"{self.name}, {self.age} лет")
Person1 = Person("Ilia", 37)
Person2 = Person("Piska", 22)
Person1.greet()
Person1.info()
Person2.greet()
Person2.info()
